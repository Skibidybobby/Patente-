# ============================================================================
# PatenteGo — Environment variables (example)
# ============================================================================
# Copy this file to `.env.local` and fill in the real values.
# NEVER commit `.env.local` — it's in .gitignore.
# ----------------------------------------------------------------------------

# Supabase public endpoint + anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://sngutjjgonwqrjxodypr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — SERVER-SIDE ONLY, never expose to the client.
# Used by admin scripts and privileged API routes (e.g. seeding quiz_items).
SUPABASE_SERVICE_ROLE_KEY=
